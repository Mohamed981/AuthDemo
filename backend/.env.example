NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/authdemo
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-of-32-plus-chars
# Access token lifetime in seconds
JWT_EXPIRES_IN=3600
# Only needed when the frontend is served from a different origin than the API
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (1 behind nginx); 0 when exposed directly
TRUST_PROXY=0
